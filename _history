ength1":18,"diffs":[[1,""]]},{"start1":5955,"length1":19,"diffs":[[1,""]]},{"start1":6191,"length1":25,"diffs":[[1,""]]}]}]},{"timestamp":1793243593632,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":1030,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"a{H4yDvroHX^I4!ryv9r\">radio_group</variable></variables><block type=\"pxt-on-start\" x=\"0\" y=\"0\"><statement name=\"HANDLER\"><block type=\"variables_set\"><field name=\"VAR\" id=\"a{H4yDvroHX^I4!ryv9r\">radio_group</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">51</field></shadow></value><next><block type=\"telloRx_server_startReceiverPcServer\"><value name=\"group\"><shadow type=\"math_number_minmax\"><mutation min=\"0\" max=\"255\" label=\"Group\" precision=\"0\"></mutation><field name=\"SLIDER\">0</field></shadow><block type=\"variables_get\"><field name=\"VAR\" id=\"a{H4yDvroHX^I4!ryv9r\">radio_group</field></block></value><next><block type=\"basic_show_icon\"><field name=\"i\">IconNames.Square</field></block></next></block></next></block></statement></block></xml>"]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":559,"length1":35,"diffs":[[1,"    \"preferredEditor\": \"tsprj\"\n"]]}]}]}],"snapshots":[{"timestamp":1793081211952,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"c^AH?KtYi5.)8oqLUu|N\">radio_group</variable></variables><block type=\"pxt-on-start\" x=\"0\" y=\"0\"><statement name=\"HANDLER\"><block type=\"variables_set\"><field name=\"VAR\" id=\"c^AH?KtYi5.)8oqLUu|N\">radio_group</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">51</field></shadow></value><next><block type=\"typescript_statement\"><mutation xmlns=\"http://www.w3.org/1999/xhtml\" line0=\"telloRx_server.startReceiverPcServer(radio_group)\" numlines=\"1\"></mutation></block></next></block></statement></block></xml>","main.ts":"","README.md":"> このページを開く [https://kawanami.github.io/kagabitiot_controller/](https://kawanami.github.io/kagabitiot_controller/)\n\n## 拡張機能として使用\n\nこのリポジトリは、MakeCode で **拡張機能** として追加できます。\n\n* [https://makecode.microbit.org/](https://makecode.microbit.org/) を開く\n* **新しいプロジェクト** をクリックしてください\n* ギアボタンメニューの中にある **拡張機能** をクリックしてください\n* **https://github.com/kawanami/kagabitiot_controller** を検索してインポートします。\n\n## このプロジェクトを編集します\n\nMakeCode でこのリポジトリを編集します。\n\n* [https://makecode.microbit.org/](https://makecode.microbit.org/) を開く\n* **読み込む** をクリックし、 **URLから読み込む...** をクリックしてください\n* **https://github.com/kawanami/kagabitiot_controller** を貼り付けてインポートをクリックしてください\n\n#### メタデータ (検索、レンダリングに使用)\n\n* for PXT/microbit\n<script src=\"https://makecode.com/gh-pages-embed.js\"></script><script>makeCodeRender(\"{{ site.makecode.home_url }}\", \"{{ site.github.owner_name }}/{{ site.github.repository_name }}\");</script>\n\n\n\n> このページを開く [https://kawanami.github.io/contest_controller/](https://kawanami.github.io/contest_controller/)\n\n## 拡張機能として使用\n\nこのリポジトリは、MakeCode で **拡張機能** として追加できます。\n\n* [https://makecode.microbit.org/](https://makecode.microbit.org/) を開く\n* **新しいプロジェクト** をクリックしてください\n* ギアボタンメニューの中にある **拡張機能** をクリックしてください\n* **https://github.com/kawanami/contest_controller** を検索してインポートします。\n\n## このプロジェクトを編集します\n\nMakeCode でこのリポジトリを編集します。\n\n* [https://makecode.microbit.org/](https://makecode.microbit.org/) を開く\n* **読み込む** をクリックし、 **URLから読み込む...** をクリックしてください\n* **https://github.com/kawanami/contest_controller** を貼り付けてインポートをクリックしてください\n\n#### メタデータ (検索、レンダリングに使用)\n\n* for PXT/microbit\n<script src=\"https://makecode.com/gh-pages-embed.js\"></script><script>makeCodeRender(\"{{ site.makecode.home_url }}\", \"{{ site.github.owner_name }}/{{ site.github.repository_name }}\");</script>\n","main.py":"def on_gesture_logo_up():\n    Tello.forward(20)\ninput.on_gesture(Gesture.LOGO_UP, on_gesture_logo_up)\n\ndef on_gesture_logo_down():\n    Tello.back(20)\ninput.on_gesture(Gesture.LOGO_DOWN, on_gesture_logo_down)\n\ndef on_button_pressed_ab():\n    Tello.fly_or_land()\n    basic.show_leds(\"\"\"\n        . . # . .\n        . # # # .\n        # # # # #\n        . . # . .\n        # # # # #\n        \"\"\")\ninput.on_button_pressed(Button.AB, on_button_pressed_ab)\n\nTello.radiosetgroup(0)\n\ndef on_forever():\n    Tello.setorder()\nbasic.forever(on_forever)\n","radioAck.ts":"// **未使用!!**\n// 通常のRadio通信において，ACKを追加する\n// Tello-Bridgeとの互換ないため，ボツ\n\nnamespace radioAck {\n    enum Mode {\n        None = 0,\n        Controller = 1,\n        Server = 2\n    }\n\n    let mode: Mode = Mode.None\n    let started = false\n\n    const RETRY_MAX = 3\n    const ACK_TIMEOUT_MS = 200\n\n    let seq = 0\n\n    // ACK待ち状態（送信側）\n    let waiting = false\n    let waitingSeq = 0\n    let acked = false\n\n    // Serverモード用受信ハンドラ\n    let rxHandler: (payload: string) => void = null\n\n    // ===== Logging =====\n    let DEBUG = true\n\n    function log(s: string) {\n        if (DEBUG) serial.writeLine(\"[radioAck] \" + s)\n    }\n\n    export function _setDebug(enabled: boolean) {\n        DEBUG = enabled\n        if (DEBUG) serial.writeLine(\"[radioAck] DEBUG ON\")\n    }\n\n    function initIfNeeded() {\n        if (started) return\n        started = true\n        radio.onReceivedString(onRx)\n        log(\"init ok (radio.onReceivedString registered)\")\n    }\n\n    function onRx(msg: string) {\n        log(\"RX raw: \" + msg)\n\n        const parts = msg.split(\",\")\n        if (parts.length < 2) {\n            log(\"RX ignored (too short)\")\n            return\n        }\n\n        const kind = parts[0]\n        const s = parseInt(parts[1])\n\n        // ACK受信\n        if (kind == \"A\") {\n            log(\"RX ACK seq=\" + s)\n\n            if (waiting && s == waitingSeq) {\n                acked = true\n                log(\"ACK matched! seq=\" + s)\n            } else {\n                log(\"ACK ignored (not waiting or seq mismatch)\")\n            }\n            return\n        }\n\n        // DATA受信\n        if (kind == \"D\") {\n            log(\"RX DATA seq=\" + s)\n\n            // ACK返信（必ず返す）\n            radio.sendString(`A,${s}`)\n            log(\"TX ACK seq=\" + s)\n\n            // Serverモードなら payload を上へ渡す\n            if (mode == Mode.Server && rxHandler) {\n                const payload = parts.slice(2).join(\",\")\n                log(\"PASS payload to handler: \" + payload)\n                rxHandler(payload)\n            } else {\n                log(\"payload ignored (mode=\" + mode + \")\")\n            }\n\n            return\n        }\n\n        log(\"RX ignored (unknown kind=\" + kind + \")\")\n    }\n\n    // =========================\n    // 開発者用 API（ブロックに出さない）\n    // =========================\n\n    export function _setModeController() {\n        initIfNeeded()\n        mode = Mode.Controller\n        rxHandler = null\n        log(\"mode set: Controller\")\n    }\n\n    export function _setModeServer(handler: (payload: string) => void) {\n        initIfNeeded()\n        mode = Mode.Server\n        rxHandler = handler\n        log(\"mode set: Server\")\n    }\n\n    // =========================\n    // 開発者用：ACK付き送信\n    // =========================\n\n    export function _sendWithAck(payload: string): boolean {\n        initIfNeeded()\n\n        if (waiting) {\n            log(\"SEND rejected (already waiting)\")\n            return false\n        }\n\n        seq = (seq + 1) & 0xffff\n        waiting = true\n        waitingSeq = seq\n        acked = false\n\n        log(\"SEND start seq=\" + waitingSeq + \" payload=\" + payload)\n\n        for (let i = 0; i < RETRY_MAX; i++) {\n            log(\"TX DATA try=\" + (i + 1) + \" seq=\" + waitingSeq)\n            radio.sendString(`D,${waitingSeq},${payload}`)\n\n            const t0 = control.millis()\n            while (control.millis() - t0 < ACK_TIMEOUT_MS) {\n                if (acked) {\n                    waiting = false\n                    log(\"SEND success seq=\" + waitingSeq)\n                    return true\n                }\n                basic.pause(5)\n            }\n\n            log(\"TIMEOUT waiting ACK seq=\" + waitingSeq)\n        }\n\n        waiting = false\n        log(\"SEND failed seq=\" + waitingSeq)\n        return false\n    }\n}\n","telloTx_controller.ts":"/**\n * Custom blocks\n */\n//% weight=0 color=#fc4c02 icon=\"\\u26a1\"\n//% block=\"ドローン\"\"\nnamespace Tello {\n    let flying = false\n    let camera = 0\n\n    /**\n     * 通信グループの設定を行う．受信機と送信機のグループ設定は合わせてね\n     * @param 通信グループの番号 value 0-255, eg: 1\n    */\n    //% block=\"【最初だけ】無線グループの設定を行う %value\"\n    //% group=\"設定\"\n    export function radiosetgroup(value: number): void {\n        radio.setGroup(value)\n        radio.setFrequencyBand(value % 84)\n        radio.setTransmitPower(7)\n    }\n    /**\n     * スピードの設定を行う、20~50の間で設定する、1につき1cm進む！\n     * @param スピードの設定を行う value 20-50, eg: 10\n     */\n    //% block=\"スピードを設定する(20-50:初期値は30) %value\"\n    //% group=\"設定\"\n    export function setspeed(value: number): void {\n        if (value > 50) {\n            value = 50\n        }\n        radioEzAck._sendWithAck(\"speed=\" + value)\n    }\n\n    // ----- 前後左右移動 -----\n    /**\n     * 受信機にドローンが前に進む命令を送信する．\n     * その時，距離も設定し送信を行う．20-500cm．\n     * @param value 前に進む距離を設定する（cm） value 20-500, eg: 50\n     */\n    //% block=\"前にすすむ(20-500) %value\"\n    //% group=\"基本\"\n    export function forward(value: number): void {\n        if (flying) {\n            if (value < 20) {\n                value = 20\n            }\n            radioEzAck._sendWithAck(\"forward=\" + value)\n        }\n    }\n\n    /**\n     * 受信機にドローンが後ろにすすむ命令を送信する．\n     * その時，距離も設定し送信を行う．20-500cm．\n     * @param value 後ろに進む距離を設定する（cm） value 20-500, eg: 50\n     */\n    //% block=\"後ろにすすむ(20-500) %value\"\n    //% group=\"基本\"\n    export function back(value: number): void {\n        if (flying) {\n            if (value < 20) {\n                value = 20\n            }\n            radioEzAck._sendWithAck(\"back=\" + value)\n        }\n    }\n\n    /**\n     * 受信機にドローンが左に進む命令を送信する．\n     * その時，距離も設定し送信を行う．20-500cm．\n     * @param value 左にすすむ距離を設定する（cm） value 20-500, eg: 50\n     */\n    //% block=\"左にすすむ(20-500) %value\"\n    //% group=\"基本\"\n    export function left(value: number): void {\n        if (flying) {\n            if (value < 20) {\n                value = 20\n            }\n            radioEzAck._sendWithAck(\"left=\" + value)\n        }\n    }\n\n    /**\n     * 受信機にドローンが右に進む命令を送信する．\n     * その時，距離も設定し送信を行う．20-500cm．\n     * @param value 右にすすむ距離を設定する（cm） value 20-500, eg: 50\n     */\n    //% block=\"右にすすむ(20-500) %value\"\n    //% group=\"基本\"\n    export function right(value: number): void {\n        if (flying) {\n            if (value < 20) {\n                value = 20\n            }\n            radioEzAck._sendWithAck(\"right=\" + value)\n        }\n    }\n\n    // ----- 上下移動 -----\n    /**\n     * 受信機にドローンが上に上がる命令を送信する．\n     * その時，距離も設定し送信を行う．20-500cm．\n     * @param value 上がる距離を設定する(cm) value 20-500, eg: 20\n     */\n    //% block=\"上にいく(20-500) %value\"\n    //% group=\"基本\"\n    export function up(value: number): void {\n        if (flying) {\n            if (value < 20) {\n                value = 20\n            }\n            radioEzAck._sendWithAck(\"up=\" + value)\n        }\n    }\n\n    /**\n     * 受信機にドローンが下に下る命令を送信する．\n     * その時，距離も設定し送信を行う．20-500cm．\n     * @param value 下がる距離を設定する（cm） value 20-500, eg: 20\n     */\n    //% block=\"下にいく(20-500) %value\"\n    //% group=\"基本\"\n    export function down(value: number): void {\n        if (flying) {\n            if (value < 20) {\n                value = 20\n            }\n            radioEzAck._sendWithAck(\"down=\" + value)\n        }\n    }\n\n    // ----- 回転 -----\n    /**\n     * 受信機にドローンが時計回りを行う命令を送信する．\n     * その時，角度を設定し送信を行う．\n     * @param value 時計回りを行う角度を設定する(degrees clockwise) value 1-360, eg: 90\n     */\n    //% block=\"時計まわり(1-360) %value\"\n    //% group=\"基本\"\n    export function rotate_cw(value: number): void {\n        if (flying) {\n            radioEzAck._sendWithAck(\"cw=\" + value)\n        }\n    }\n\n    /**\n     * 受信機にドローンが反時計回りを行う命令を送信する．\n     * その時，角度を設定し送信を行う．\n     * @param value 反時計回りを行う角度を設定する(degrees counterclockwise) value 1-360, eg: 90\n     */\n    //% block=\"反時計まわり(1-360) %value\"\n    //% group=\"基本\"\n    export function rotate_ccw(value: number): void {\n        if (flying) {\n            radioEzAck._sendWithAck(\"ccw=\" + value)\n        }\n    }\n\n    // ----- 離陸着陸 -----\n    /**\n      * コントローラー内の変数を確認して離陸するか，着陸を行う．\n      */\n    //% block=\"りりく/ちゃくりく\"\n    //% group=\"基本\"\n    export function fly_or_land(): void {\n        if (!flying) {\n            let takeoffOk = radioEzAck._sendWithAck(\"takeoff\")\n            if (takeoffOk) { flying = true; }\n        } else if (flying) {\n            let landOk = radioEzAck._sendWithAck(\"land\")\n            if (landOk) { flying = false; }\n        }\n    }\n\n    /**\n     * 受信機にドローンが離陸する命令を送信する．\n     */\n    //% block=\"離陸する\"\n    //% group=\"離陸と着陸\"\n    export function takeoff(): void {\n        let takeoffOk = radioEzAck._sendWithAck(\"takeoff\")\n        if (takeoffOk) { flying = true; }\n    }\n\n    /**\n     * 受信機にドローンが着陸する命令を送信する．\n    */\n    //% block=\"着陸する\"\n    //% group=\"離陸と着陸\"\n    export function land(): void {\n        let landOk = radioEzAck._sendWithAck(\"land\")\n        if (landOk) { flying = false; }\n    }\n\n    /**\n     * ドローンの飛行状態の変数を取得する．\n    */\n    //% block=\"ドローンが飛行をしている\"\n    //% group=\"離陸と着陸\"\n    export function getflying(): boolean {\n        if (flying) {\n            return true\n        } else {\n            return false\n        }\n    }\n\n    // ----- 前後左右フリップ------\n    /**\n     * ドローンが左フリップします！おしゃれ！\n     */\n    //% block=\"左フリップする(バッテリー50以上推奨)\"\n    //% group=\"フリップ\"\n    export function left_flip(): void {\n        if (flying) {\n            radioEzAck._sendWithAck(\"flip=l\")\n        }\n    }\n\n    /**\n     * ドローンが右フリップします！おしゃれ！\n     */\n    //% block=\"右フリップする(バッテリー50以上推奨)\"\n    //% group=\"フリップ\"\n    export function right_flip(): void {\n        if (flying) {\n            radioEzAck._sendWithAck(\"flip=r\")\n        }\n    }\n\n    /**\n     * ドローンが後ろフリップします！おしゃれ！\n     */\n    //% block=\"後ろフリップする(バッテリー50以上推奨)\"\n    //% group=\"フリップ\"\n    export function back_flip(): void {\n        if (flying) {\n            radioEzAck._sendWithAck(\"flip=b\")\n        }\n    }\n\n    /**\n      * ドローンが前フリップします！おしゃれ！\n      */\n    //% block=\"前フリップする(バッテリー50以上推奨)\"\n    //% group=\"フリップ\"\n    export function forward_flip(): void {\n        if (flying) {\n            radioEzAck._sendWithAck(\"flip=f\")\n        }\n    }\n\n    // -----  その他 ------\n    /**\n     * カメラを切り替える\n     */\n    //% block=\"カメラを切り替える \"\n    //% group=\"コンテスト用\"\n    export function swiching_camera(): void {\n        if (flying) {\n            if (camera) {\n                radioEzAck._sendWithAck(\"downvision 0\")\n                camera = 0\n            } else {\n                radioEzAck._sendWithAck(\"downvision 1\")\n                camera = 1\n            }\n        }\n    }\n\n    /**\n        * ドローンが三次元で移動します．20以下の移動は不可,speedは10以上．\n        * @param x x -500-500, eg: 0\n        * @param y y -500-500, eg: 0\n        * @param z z -500-500, eg: 0\n        * @param speed speed 10-100, eg: 0\n        */\n    //% block=\"自由飛行(距離は±20以上) | 前後（前が＋） %x 上下（上が＋） %y 左右（左が＋） %z スピード(10以上) %speed\"\n    //% group=\"応用\"\n    export function xyz(x: number, y: number, z: number, speed: number): void {\n        if (flying) {\n            let sendstring = \"go=\" + x + \" \" + z + \" \" + y + \" \" + speed\n            radioEzAck._sendWithAck(sendstring)\n        }\n    }\n}","telloRx_server.ts":"//% advanced=true\r\n//% block=\"⚠スタッフ用⚠ Tello受信機初期化\"\r\n//% group.min=0 group.max=255\r\nnamespace telloRx_server {\r\n    let started = false\r\n\r\n    let hasPending = false\r\n    let pending = \"\"\r\n\r\n    // 外部クラスからシリアル送信行う用（tello_bridgeクラスで利用中）\r\n    export function _sendToSerial(s: string) {\r\n        pending = \"\" + s\r\n        hasPending = true\r\n    }\r\n\r\n    function startSerialWorkerOnce() {\r\n        control.inBackground(() => {\r\n            while (true) {\r\n                if (hasPending) {\r\n                    const s = pending\r\n                    hasPending = false\r\n\r\n                    serial.writeLine(s)\r\n                }\r\n                basic.pause(1)\r\n            }\r\n        })\r\n    }\r\n\r\n    function _startReceiverCommon(group: number, showIcon: boolean) {\r\n        if (started) return\r\n        started = true\r\n\r\n        radio.setGroup(group)\r\n        radio.setTransmitPower(7)\r\n        radio.setFrequencyBand(group % 84)\r\n\r\n        startSerialWorkerOnce()\r\n\r\n        radioEzAck._setModeServer((payload: string) => {\r\n            pending = \"\" + payload\r\n            hasPending = true\r\n        }, showIcon)\r\n    }\r\n\r\n    //% block=\"⚠スタッフ用⚠ 【最初だけ】PCサーバー受信機 初期化\"\r\n    //% group.min=0 group.max=255\r\n    export function startReceiverPcServer(group: number) {\r\n        _startReceiverCommon(group, false)\r\n    }\r\n\r\n    //% block=\"⚠スタッフ用⚠ 【最初だけ】Tello-Bridge受信機 初期化\"\r\n    //% group.min=0 group.max=255\r\n    export function startReceiverTelloBridge(group: number) {\r\n        _startReceiverCommon(group, true)\r\n    }\r\n}","radioEzAck.ts":"// **使用中!!**\n// 通常のRadio通信において，簡易的なACK処理を追加する\n// Tello-Bridgeとの互換ありのため，採用\n\n// 問題点：Tello-Bridgeで利用する際は必ず3回コマンドが送信される．（ACK返答がないため）\n// Tello-Bridgeでは短期間における連続コマンド受信は無視するため，重複動作は行わない（動作確認済み）\n\nnamespace radioEzAck {\n    enum Mode {\n        None = 0,\n        Controller = 1,\n        Server = 2\n    }\n\n    let mode: Mode = Mode.None\n    let inited = false\n\n    const ACK_TEXT = \"OK\"\n    const RETRY_MAX = 3\n    let ACK_TIMEOUT_MS = 100\n    let SHOW_RX_CMD_ICON = false\n    let DEBUG = false\n\n    let waiting = false\n    let acked = false\n\n    let rxHandler: (cmd: string) => void = null\n\n    function log(s: string) {\n        if (DEBUG) serial.writeLine(\"[radioEzAck] \" + s)\n    }\n    export function setDebug(enabled: boolean) {\n        DEBUG = enabled\n        if (DEBUG) serial.writeLine(\"[radioEzAck] DEBUG ON\")\n    }\n    export function setAckTimeout(ms: number) {\n        ACK_TIMEOUT_MS = ms\n        log(\"ACK_TIMEOUT_MS=\" + ms)\n    }\n\n    function initIfNeeded() {\n        if (inited) return\n        inited = true\n        radio.onReceivedString(onRx)\n        log(\"init ok\")\n    }\n\n    function onRx(msg: string) {\n        // ACK受信\n        if (msg == ACK_TEXT) {\n            if (waiting) {\n                acked = true\n                log(\"RX ACK (OK) -> matched\")\n            } else {\n                log(\"RX ACK (OK) -> ignored (not waiting)\")\n            }\n            return\n        }\n\n        if (mode == Mode.Server) {\n            const cmd = \"\" + msg // 念のためコピー\n            log(\"RX CMD: \" + cmd)\n\n            // ★受信イベント内で重いことはしない：handlerもACK送信も外へ\n            control.inBackground(() => {\n                // handler（Tello-Bridge互換）\n                if (rxHandler) rxHandler(cmd)\n\n                // ACK返信（受信イベント外）\n                basic.pause(10)\n                radio.sendString(ACK_TEXT)\n                log(\"TX ACK (OK)\")\n\n                if (SHOW_RX_CMD_ICON) {\n                    basic.showIcon(IconNames.Target)\n                    basic.pause((300))\n                    basic.clearScreen()\n                }\n            })\n            return\n        }\n\n        // NOTE: サーバ → コントローラ通信実装時に利用\n        // TODO: 実装を完了させる\n        if (mode == Mode.Controller) {\n        }\n\n        log(\"RX ignored (mode=\" + mode + \" msg=\" + msg + \")\")\n    }\n\n    export function _setModeController() {\n        initIfNeeded()\n        mode = Mode.Controller\n        rxHandler = null\n        log(\"mode=Controller\")\n    }\n\n    export function _setModeServer(handler: (cmd: string) => void, showRxIcon: boolean = false) {\n        initIfNeeded()\n        mode = Mode.Server\n        rxHandler = handler\n        SHOW_RX_CMD_ICON = showRxIcon\n        log(\"mode=Server showRxIcon=\" + showRxIcon)\n    }\n\n    export function _sendWithAck(cmd: string): boolean {\n        initIfNeeded()\n\n        if (waiting) {\n            log(\"SEND rejected (already waiting)\")\n            return false\n        }\n\n        waiting = true\n        acked = false\n\n        log(\"SEND start cmd=\" + cmd)\n\n        for (let i = 0; i < RETRY_MAX; i++) {\n            log(\"TX cmd try=\" + (i + 1))\n            radio.sendString(cmd)\n\n            const t0 = control.millis()\n            while (control.millis() - t0 < ACK_TIMEOUT_MS) {\n                if (acked) {\n                    waiting = false\n                    log(\"SEND success\")\n                    return true\n                }\n                basic.pause(5)\n            }\n            log(\"TIMEOUT (no OK)\")\n        }\n\n        waiting = false\n        log(\"SEND failed\")\n        return false\n    }\n}\n","pxt.json":"{\n    \"name\": \"contest_controller\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"main.py\",\n        \"radioAck.ts\",\n        \"telloTx_controller.ts\",\n        \"telloRx_server.ts\",\n        \"radioEzAck.ts\"\n    ],\n    \"testFiles\": [\n        \"test.ts\"\n    ],\n    \"targetVersions\": {\n        \"target\": \"7.0.51\",\n        \"targetId\": \"microbit\"\n    },\n    \"supportedTargets\": [\n        \"microbit\"\n    ],\n    \"preferredEditor\": \"blocksprj\"\n}\n","test.ts":"// テストはここに来ます。このパッケージが拡張機能として使用されるときにはコンパイルされません。\n"}},{"timestamp":1793097368088,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"!^.w,|{_/pE--FCD]*fl\">radio_group</variable></variables><block type=\"pxt-on-start\" x=\"0\" y=\"0\"><statement name=\"HANDLER\"><block type=\"variables_set\"><field name=\"VAR\" id=\"!^.w,|{_/pE--FCD]*fl\">radio_group</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">51</field></shadow></value><next><block type=\"telloRx_server_startReceiverPcServer\"><value name=\"number\"><shadow type=\"math_number_minmax\"><mutation min=\"0\" max=\"255\" label=\"Group\" precision=\"0\"></mutation><field name=\"SLIDER\">0</field></shadow><block type=\"variables_get\"><field name=\"VAR\" id=\"!^.w,|{_/pE--FCD]*fl\">radio_group</field></block></value><next><block type=\"basic_show_icon\"><field name=\"i\">IconNames.Square</field></block></next></block></next></block></statement></block></xml>","main.ts":"let radio_group = 51\ntelloRx_server.startReceiverPcServer(radio_group)\nbasic.showIcon(IconNames.Square)\n","README.md":"> このページを開く [https://kawanami.github.io/kagabitiot_controller/](https://kawanami.github.io/kagabitiot_controller/)\n\n## 拡張機能として使用\n\nこのリポジトリは、MakeCode で **拡張機能** として追加できます。\n\n* [https://makecode.microbit.org/](https://makecode.microbit.org/) を開く\n* **新しいプロジェクト** をクリックしてください\n* ギアボタンメニューの中にある **拡張機能** をクリックしてください\n* **https://github.com/kawanami/kagabitiot_controller** を検索してインポートします。\n\n## このプロジェクトを編集します\n\nMakeCode でこのリポジトリを編集します。\n\n* [https://makecode.microbit.org/](https://makecode.microbit.org/) を開く\n* **読み込む** をクリックし、 **URLから読み込む...** をクリックしてください\n* **https://github.com/kawanami/kagabitiot_controller** を貼り付けてインポートをクリックしてください\n\n#### メタデータ (検索、レンダリングに使用)\n\n* for PXT/microbit\n<script src=\"https://makecode.com/gh-pages-embed.js\"></script><script>makeCodeRender(\"{{ site.makecode.home_url }}\", \"{{ site.github.owner_name }}/{{ site.github.repository_name }}\");</script>\n\n\n\n> このページを開く [https://kawanami.github.io/contest_controller/](https://kawanami.github.io/contest_controller/)\n\n## 拡張機能として使用\n\nこのリポジトリは、MakeCode で **拡張機能** として追加できます。\n\n* [https://makecode.microbit.org/](https://makecode.microbit.org/) を開く\n* **新しいプロジェクト** をクリックしてください\n* ギアボタンメニューの中にある **拡張機能** をクリックしてください\n* **https://github.com/kawanami/contest_controller** を検索してインポートします。\n\n## このプロジェクトを編集します\n\nMakeCode でこのリポジトリを編集します。\n\n* [https://makecode.microbit.org/](https://makecode.microbit.org/) を開く\n* **読み込む** をクリックし、 **URLから読み込む...** をクリックしてください\n* **https://github.com/kawanami/contest_controller** を貼り付けてインポートをクリックしてください\n\n#### メタデータ (検索、レンダリングに使用)\n\n* for PXT/microbit\n<script src=\"https://makecode.com/gh-pages-embed.js\"></script><script>makeCodeRender(\"{{ site.makecode.home_url }}\", \"{{ site.github.owner_name }}/{{ site.github.repository_name }}\");</script>\n","main.py":"radio_group = 51\ntelloRx_server.start_receiver_pc_server(radio_group)\nbasic.show_icon(IconNames.SQUARE)","radioAck.ts":"// **未使用!!**\n// 通常のRadio通信において，ACKを追加する\n// Tello-Bridgeとの互換ないため，ボツ\n\nnamespace radioAck {\n    enum Mode {\n        None = 0,\n        Controller = 1,\n        Server = 2\n    }\n\n    let mode: Mode = Mode.None\n    let started = false\n\n    const RETRY_MAX = 3\n    const ACK_TIMEOUT_MS = 200\n\n    let seq = 0\n\n    // ACK待ち状態（送信側）\n    let waiting = false\n    let waitingSeq = 0\n    let acked = false\n\n    // Serverモード用受信ハンドラ\n    let rxHandler: (payload: string) => void = null\n\n    // ===== Logging =====\n    let DEBUG = true\n\n    function log(s: string) {\n        if (DEBUG) serial.writeLine(\"[radioAck] \" + s)\n    }\n\n    export function _setDebug(enabled: boolean) {\n        DEBUG = enabled\n        if (DEBUG) serial.writeLine(\"[radioAck] DEBUG ON\")\n    }\n\n    function initIfNeeded() {\n        if (started) return\n        started = true\n        radio.onReceivedString(onRx)\n        log(\"init ok (radio.onReceivedString registered)\")\n    }\n\n    function onRx(msg: string) {\n        log(\"RX raw: \" + msg)\n\n        const parts = msg.split(\",\")\n        if (parts.length < 2) {\n            log(\"RX ignored (too short)\")\n            return\n        }\n\n        const kind = parts[0]\n        const s = parseInt(parts[1])\n\n        // ACK受信\n        if (kind == \"A\") {\n            log(\"RX ACK seq=\" + s)\n\n            if (waiting && s == waitingSeq) {\n                acked = true\n                log(\"ACK matched! seq=\" + s)\n            } else {\n                log(\"ACK ignored (not waiting or seq mismatch)\")\n            }\n            return\n        }\n\n        // DATA受信\n        if (kind == \"D\") {\n            log(\"RX DATA seq=\" + s)\n\n            // ACK返信（必ず返す）\n            radio.sendString(`A,${s}`)\n            log(\"TX ACK seq=\" + s)\n\n            // Serverモードなら payload を上へ渡す\n            if (mode == Mode.Server && rxHandler) {\n                const payload = parts.slice(2).join(\",\")\n                log(\"PASS payload to handler: \" + payload)\n                rxHandler(payload)\n            } else {\n                log(\"payload ignored (mode=\" + mode + \")\")\n            }\n\n            return\n        }\n\n        log(\"RX ignored (unknown kind=\" + kind + \")\")\n    }\n\n    // =========================\n    // 開発者用 API（ブロックに出さない）\n    // =========================\n\n    export function _setModeController() {\n        initIfNeeded()\n        mode = Mode.Controller\n        rxHandler = null\n        log(\"mode set: Controller\")\n    }\n\n    export function _setModeServer(handler: (payload: string) => void) {\n        initIfNeeded()\n        mode = Mode.Server\n        rxHandler = handler\n        log(\"mode set: Server\")\n    }\n\n    // =========================\n    // 開発者用：ACK付き送信\n    // =========================\n\n    export function _sendWithAck(payload: string): boolean {\n        initIfNeeded()\n\n        if (waiting) {\n            log(\"SEND rejected (already waiting)\")\n            return false\n        }\n\n        seq = (seq + 1) & 0xffff\n        waiting = true\n        waitingSeq = seq\n        acked = false\n\n        log(\"SEND start seq=\" + waitingSeq + \" payload=\" + payload)\n\n        for (let i = 0; i < RETRY_MAX; i++) {\n            log(\"TX DATA try=\" + (i + 1) + \" seq=\" + waitingSeq)\n            radio.sendString(`D,${waitingSeq},${payload}`)\n\n            const t0 = control.millis()\n            while (control.millis() - t0 < ACK_TIMEOUT_MS) {\n                if (acked) {\n                    waiting = false\n                    log(\"SEND success seq=\" + waitingSeq)\n                    return true\n                }\n                basic.pause(5)\n            }\n\n            log(\"TIMEOUT waiting ACK seq=\" + waitingSeq)\n        }\n\n        waiting = false\n        log(\"SEND failed seq=\" + waitingSeq)\n        return false\n    }\n}\n","telloTx_controller.ts":"/**\n * Custom blocks\n */\n//% weight=0 color=#fc4c02 icon=\"\\u26a1\"\n//% block=\"ドローン\"\"\nnamespace Tello {\n    let flying = false\n    let camera = 0\n\n    /**\n     * 通信グループの設定を行う．受信機と送信機のグループ設定は合わせてね\n     * @param 通信グループの番号 value 0-255, eg: 1\n    */\n    //% block=\"【最初だけ】無線グループの設定を行う %value\"\n    //% group=\"設定\"\n    export function radiosetgroup(value: number): void {\n        radio.setGroup(value)\n        radio.setFrequencyBand(value % 84)\n        radio.setTransmitPower(7)\n    }\n    /**\n     * スピードの設定を行う、20~50の間で設定する、1につき1cm進む！\n     * @param スピードの設定を行う value 20-50, eg: 10\n     */\n    //% block=\"スピードを設定する(20-50:初期値は30) %value\"\n    //% group=\"設定\"\n    export function setspeed(value: number): void {\n        if (value > 50) {\n            value = 50\n        }\n        radioEzAck._sendWithAck(\"speed=\" + value)\n    }\n\n    // ----- 前後左右移動 -----\n    /**\n     * 受信機にドローンが前に進む命令を送信する．\n     * その時，距離も設定し送信を行う．20-500cm．\n     * @param value 前に進む距離を設定する（cm） value 20-500, eg: 50\n     */\n    //% block=\"前にすすむ(20-500) %value\"\n    //% group=\"基本\"\n    export function forward(value: number): void {\n        if (flying) {\n            if (value < 20) {\n                value = 20\n            }\n            radioEzAck._sendWithAck(\"forward=\" + value)\n        }\n    }\n\n    /**\n     * 受信機にドローンが後ろにすすむ命令を送信する．\n     * その時，距離も設定し送信を行う．20-500cm．\n     * @param value 後ろに進む距離を設定する（cm） value 20-500, eg: 50\n     */\n    //% block=\"後ろにすすむ(20-500) %value\"\n    //% group=\"基本\"\n    export function back(value: number): void {\n        if (flying) {\n            if (value < 20) {\n                value = 20\n            }\n            radioEzAck._sendWithAck(\"back=\" + value)\n        }\n    }\n\n    /**\n     * 受信機にドローンが左に進む命令を送信する．\n     * その時，距離も設定し送信を行う．20-500cm．\n     * @param value 左にすすむ距離を設定する（cm） value 20-500, eg: 50\n     */\n    //% block=\"左にすすむ(20-500) %value\"\n    //% group=\"基本\"\n    export function left(value: number): void {\n        if (flying) {\n            if (value < 20) {\n                value = 20\n            }\n            radioEzAck._sendWithAck(\"left=\" + value)\n        }\n    }\n\n    /**\n     * 受信機にドローンが右に進む命令を送信する．\n     * その時，距離も設定し送信を行う．20-500cm．\n     * @param value 右にすすむ距離を設定する（cm） value 20-500, eg: 50\n     */\n    //% block=\"右にすすむ(20-500) %value\"\n    //% group=\"基本\"\n    export function right(value: number): void {\n        if (flying) {\n            if (value < 20) {\n                value = 20\n            }\n            radioEzAck._sendWithAck(\"right=\" + value)\n        }\n    }\n\n    // ----- 上下移動 -----\n    /**\n     * 受信機にドローンが上に上がる命令を送信する．\n     * その時，距離も設定し送信を行う．20-500cm．\n     * @param value 上がる距離を設定する(cm) value 20-500, eg: 20\n     */\n    //% block=\"上にいく(20-500) %value\"\n    //% group=\"基本\"\n    export function up(value: number): void {\n        if (flying) {\n            if (value < 20) {\n                value = 20\n            }\n            radioEzAck._sendWithAck(\"up=\" + value)\n        }\n    }\n\n    /**\n     * 受信機にドローンが下に下る命令を送信する．\n     * その時，距離も設定し送信を行う．20-500cm．\n     * @param value 下がる距離を設定する（cm） value 20-500, eg: 20\n     */\n    //% block=\"下にいく(20-500) %value\"\n    //% group=\"基本\"\n    export function down(value: number): void {\n        if (flying) {\n            if (value < 20) {\n                value = 20\n            }\n            radioEzAck._sendWithAck(\"down=\" + value)\n        }\n    }\n\n    // ----- 回転 -----\n    /**\n     * 受信機にドローンが時計回りを行う命令を送信する．\n     * その時，角度を設定し送信を行う．\n     * @param value 時計回りを行う角度を設定する(degrees clockwise) value 1-360, eg: 90\n     */\n    //% block=\"時計まわり(1-360) %value\"\n    //% group=\"基本\"\n    export function rotate_cw(value: number): void {\n        if (flying) {\n            radioEzAck._sendWithAck(\"cw=\" + value)\n        }\n    }\n\n    /**\n     * 受信機にドローンが反時計回りを行う命令を送信する．\n     * その時，角度を設定し送信を行う．\n     * @param value 反時計回りを行う角度を設定する(degrees counterclockwise) value 1-360, eg: 90\n     */\n    //% block=\"反時計まわり(1-360) %value\"\n    //% group=\"基本\"\n    export function rotate_ccw(value: number): void {\n        if (flying) {\n            radioEzAck._sendWithAck(\"ccw=\" + value)\n        }\n    }\n\n    // ----- 離陸着陸 -----\n    /**\n      * コントローラー内の変数を確認して離陸するか，着陸を行う．\n      */\n    //% block=\"りりく/ちゃくりく\"\n    //% group=\"基本\"\n    export function fly_or_land(): void {\n        if (!flying) {\n            let takeoffOk = radioEzAck._sendWithAck(\"takeoff\")\n            if (takeoffOk) { flying = true; }\n        } else if (flying) {\n            let landOk = radioEzAck._sendWithAck(\"land\")\n            if (landOk) { flying = false; }\n        }\n    }\n\n    /**\n     * 受信機にドローンが離陸する命令を送信する．\n     */\n    //% block=\"離陸する\"\n    //% group=\"離陸と着陸\"\n    export function takeoff(): void {\n        let takeoffOk = radioEzAck._sendWithAck(\"takeoff\")\n        if (takeoffOk) { flying = true; }\n    }\n\n    /**\n     * 受信機にドローンが着陸する命令を送信する．\n    */\n    //% block=\"着陸する\"\n    //% group=\"離陸と着陸\"\n    export function land(): void {\n        let landOk = radioEzAck._sendWithAck(\"land\")\n        if (landOk) { flying = false; }\n    }\n\n    /**\n     * ドローンの飛行状態の変数を取得する．\n    */\n    //% block=\"ドローンが飛行をしている\"\n    //% group=\"離陸と着陸\"\n    export function getflying(): boolean {\n        if (flying) {\n            return true\n        } else {\n            return false\n        }\n    }\n\n    // ----- 前後左右フリップ------\n    /**\n     * ドローンが左フリップします！おしゃれ！\n     */\n    //% block=\"左フリップする(バッテリー50以上推奨)\"\n    //% group=\"フリップ\"\n    export function left_flip(): void {\n        if (flying) {\n            radioEzAck._sendWithAck(\"flip=l\")\n        }\n    }\n\n    /**\n     * ドローンが右フリップします！おしゃれ！\n     */\n    //% block=\"右フリップする(バッテリー50以上推奨)\"\n    //% group=\"フリップ\"\n    export function right_flip(): void {\n        if (flying) {\n            radioEzAck._sendWithAck(\"flip=r\")\n        }\n    }\n\n    /**\n     * ドローンが後ろフリップします！おしゃれ！\n     */\n    //% block=\"後ろフリップする(バッテリー50以上推奨)\"\n    //% group=\"フリップ\"\n    export function back_flip(): void {\n        if (flying) {\n            radioEzAck._sendWithAck(\"flip=b\")\n        }\n    }\n\n    /**\n      * ドローンが前フリップします！おしゃれ！\n      */\n    //% block=\"前フリップする(バッテリー50以上推奨)\"\n    //% group=\"フリップ\"\n    export function forward_flip(): void {\n        if (flying) {\n            radioEzAck._sendWithAck(\"flip=f\")\n        }\n    }\n\n    // -----  その他 ------\n    /**\n     * カメラを切り替える\n     */\n    //% block=\"カメラを切り替える \"\n    //% group=\"コンテスト用\"\n    export function swiching_camera(): void {\n        if (flying) {\n            if (camera) {\n                radioEzAck._sendWithAck(\"downvision 0\")\n                camera = 0\n            } else {\n                radioEzAck._sendWithAck(\"downvision 1\")\n                camera = 1\n            }\n        }\n    }\n\n    /**\n        * ドローンが三次元で移動します．20以下の移動は不可,speedは10以上．\n        * @param x x -500-500, eg: 0\n        * @param y y -500-500, eg: 0\n        * @param z z -500-500, eg: 0\n        * @param speed speed 10-100, eg: 0\n        */\n    //% block=\"自由飛行(距離は±20以上) | 前後（前が＋） %x 上下（上が＋） %y 左右（左が＋） %z スピード(10以上) %speed\"\n    //% group=\"応用\"\n    export function xyz(x: number, y: number, z: number, speed: number): void {\n        if (flying) {\n            let sendstring = \"go=\" + x + \" \" + z + \" \" + y + \" \" + speed\n            radioEzAck._sendWithAck(sendstring)\n        }\n    }\n}","telloRx_server.ts":"//% advanced=true\r\n//% block=\"⚠スタッフ用⚠ Tello受信機ブロック\"\r\n//% group.min=0 group.max=255\r\nnamespace telloRx_server {\r\n    let started = false\r\n\r\n    let hasPending = false\r\n    let pending = \"\"\r\n\r\n    // 外部クラスからシリアル送信行う用（tello_bridgeクラスで利用中）\r\n    export function _sendToSerial(s: string) {\r\n        pending = \"\" + s\r\n        hasPending = true\r\n    }\r\n\r\n    function startSerialWorkerOnce() {\r\n        control.inBackground(() => {\r\n            while (true) {\r\n                if (hasPending) {\r\n                    const s = pending\r\n                    hasPending = false\r\n\r\n                    serial.writeLine(s)\r\n                }\r\n                basic.pause(1)\r\n            }\r\n        })\r\n    }\r\n\r\n    function _startReceiverCommon(group: number, showIcon: boolean) {\r\n        if (started) return\r\n        started = true\r\n\r\n        radio.setGroup(group)\r\n        radio.setTransmitPower(7)\r\n        radio.setFrequencyBand(group % 84)\r\n\r\n        startSerialWorkerOnce()\r\n\r\n        radioEzAck._setModeServer((payload: string) => {\r\n            pending = \"\" + payload\r\n            hasPending = true\r\n        }, showIcon)\r\n    }\r\n\r\n    //% block=\"⚠スタッフ用⚠ 【最初だけ】PCサーバー受信機 （受信表示無） %number\"\r\n    //% group.min=0 group.max=255\r\n    export function startReceiverPcServerNoIcon(group: number) {\r\n        _startReceiverCommon(group, false)\r\n    }\r\n\r\n    //% block=\"⚠スタッフ用⚠ 【最初だけ】PCサーバー受信機 （受信表示有） %number\"\r\n    //% group.min=0 group.max=255\r\n    export function startReceiverPcServer(group: number) {\r\n        _startReceiverCommon(group, true)\r\n    }\r\n}","radioEzAck.ts":"// **使用中!!**\n// 通常のRadio通信において，簡易的なACK処理を追加する\n// Tello-Bridgeとの互換ありのため，採用\n\n// 問題点：Tello-Bridgeで利用する際は必ず3回コマンドが送信される．（ACK返答がないため）\n// Tello-Bridgeでは短期間における連続コマンド受信は無視するため，重複動作は行わない（動作確認済み）\n\nnamespace radioEzAck {\n    enum Mode {\n        None = 0,\n        Controller = 1,\n        Server = 2\n    }\n\n    let mode: Mode = Mode.None\n    let inited = false\n\n    const ACK_TEXT = \"OK\"\n    const RETRY_MAX = 3\n    let ACK_TIMEOUT_MS = 100\n    let SHOW_RX_CMD_ICON = false\n    let DEBUG = false\n\n    let waiting = false\n    let acked = false\n\n    let rxHandler: (cmd: string) => void = null\n\n    function log(s: string) {\n        if (DEBUG) serial.writeLine(\"[radioEzAck] \" + s)\n    }\n    export function setDebug(enabled: boolean) {\n        DEBUG = enabled\n        if (DEBUG) serial.writeLine(\"[radioEzAck] DEBUG ON\")\n    }\n    export function setAckTimeout(ms: number) {\n        ACK_TIMEOUT_MS = ms\n        log(\"ACK_TIMEOUT_MS=\" + ms)\n    }\n\n    function initIfNeeded() {\n        if (inited) return\n        inited = true\n        radio.onReceivedString(onRx)\n        log(\"init ok\")\n    }\n\n    function onRx(msg: string) {\n        // ACK受信\n        if (msg == ACK_TEXT) {\n            if (waiting) {\n                acked = true\n                log(\"RX ACK (OK) -> matched\")\n            } else {\n                log(\"RX ACK (OK) -> ignored (not waiting)\")\n            }\n            return\n        }\n\n        if (mode == Mode.Server) {\n            const cmd = \"\" + msg // 念のためコピー\n            log(\"RX CMD: \" + cmd)\n\n            // ★受信イベント内で重いことはしない：handlerもACK送信も外へ\n            control.inBackground(() => {\n                // handler（Tello-Bridge互換）\n                if (rxHandler) rxHandler(cmd)\n\n                // ACK返信（受信イベント外）\n                basic.pause(10)\n                radio.sendString(ACK_TEXT)\n                log(\"TX ACK (OK)\")\n\n                if (SHOW_RX_CMD_ICON) {\n                    basic.showIcon(IconNames.Target)\n                    basic.pause((300))\n                    basic.clearScreen()\n                }\n            })\n            return\n        }\n\n        // NOTE: サーバ → コントローラ通信実装時に利用\n        // TODO: 実装を完了させる\n        if (mode == Mode.Controller) {\n        }\n\n        log(\"RX ignored (mode=\" + mode + \" msg=\" + msg + \")\")\n    }\n\n    export function _setModeController() {\n        initIfNeeded()\n        mode = Mode.Controller\n        rxHandler = null\n        log(\"mode=Controller\")\n    }\n\n    export function _setModeServer(handler: (cmd: string) => void, showRxIcon: boolean = false) {\n        initIfNeeded()\n        mode = Mode.Server\n        rxHandler = handler\n        SHOW_RX_CMD_ICON = showRxIcon\n        log(\"mode=Server showRxIcon=\" + showRxIcon)\n    }\n\n    export function _sendWithAck(cmd: string): boolean {\n        initIfNeeded()\n\n        if (waiting) {\n            log(\"SEND rejected (already waiting)\")\n            return false\n        }\n\n        waiting = true\n        acked = false\n\n        log(\"SEND start cmd=\" + cmd)\n\n        for (let i = 0; i < RETRY_MAX; i++) {\n            log(\"TX cmd try=\" + (i + 1))\n            radio.sendString(cmd)\n\n            const t0 = control.millis()\n            while (control.millis() - t0 < ACK_TIMEOUT_MS) {\n                if (acked) {\n                    waiting = false\n                    log(\"SEND success\")\n                    return true\n                }\n                basic.pause(5)\n            }\n            log(\"TIMEOUT (no OK)\")\n        }\n\n        waiting = false\n        log(\"SEND failed\")\n        return false\n    }\n}\n","pxt.json":"{\n    \"name\": \"contest_receiver_2026\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"main.py\",\n        \"radioAck.ts\",\n        \"telloTx_controller.ts\",\n        \"telloRx_server.ts\",\n        \"radioEzAck.ts\"\n    ],\n    \"testFiles\": [\n        \"test.ts\"\n    ],\n    \"targetVersions\": {\n        \"target\": \"7.0.51\",\n        \"targetId\": \"microbit\"\n    },\n    \"supportedTargets\": [\n        \"microbit\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n","test.ts":"// テストはここに来ます。このパッケージが拡張機能として使用されるときにはコンパイルされません。\n"}},{"timestamp":1793242260072,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"!^.w,|{_/pE--FCD]*fl\">radio_group</variable></variables><block type=\"pxt-on-start\" x=\"0\" y=\"0\"><statement name=\"HANDLER\"><block type=\"variables_set\"><field name=\"VAR\" id=\"!^.w,|{_/pE--FCD]*fl\">radio_group</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">51</field></shadow></value><next><block type=\"telloRx_server_startReceiverPcServer\"><value name=\"number\"><shadow type=\"math_number_minmax\"><mutation min=\"0\" max=\"255\" label=\"Group\" precision=\"0\"></mutation><field name=\"SLIDER\">0</field></shadow><block type=\"variables_get\"><field name=\"VAR\" id=\"!^.w,|{_/pE--FCD]*fl\">radio_group</field></block></value><next><block type=\"basic_show_icon\"><field name=\"i\">IconNames.Square</field></block></next></block></next></block></statement></block></xml>","main.ts":"let radio_group = 51\ntelloRx_server.startReceiverPcServer(radio_group)\nbasic.showIcon(IconNames.Square)\n","README.md":"> このページを開く [https://kawanami.github.io/kagabitiot_controller/](https://kawanami.github.io/kagabitiot_controller/)\n\n## 拡張機能として使用\n\nこのリポジトリは、MakeCode で **拡張機能** として追加できます。\n\n* [https://makecode.microbit.org/](https://makecode.microbit.org/) を開く\n* **新しいプロジェクト** をクリックしてください\n* ギアボタンメニューの中にある **拡張機能** をクリックしてください\n* **https://github.com/kawanami/kagabitiot_controller** を検索してインポートします。\n\n## このプロジェクトを編集します\n\nMakeCode でこのリポジトリを編集します。\n\n* [https://makecode.microbit.org/](https://makecode.microbit.org/) を開く\n* **読み込む** をクリックし、 **URLから読み込む...** をクリックしてください\n* **https://github.com/kawanami/kagabitiot_controller** を貼り付けてインポートをクリックしてください\n\n#### メタデータ (検索、レンダリングに使用)\n\n* for PXT/microbit\n<script src=\"https://makecode.com/gh-pages-embed.js\"></script><script>makeCodeRender(\"{{ site.makecode.home_url }}\", \"{{ site.github.owner_name }}/{{ site.github.repository_name }}\");</script>\n\n\n\n> このページを開く [https://kawanami.github.io/contest_controller/](https://kawanami.github.io/contest_controller/)\n\n## 拡張機能として使用\n\nこのリポジトリは、MakeCode で **拡張機能** として追加できます。\n\n* [https://makecode.microbit.org/](https://makecode.microbit.org/) を開く\n* **新しいプロジェクト** をクリックしてください\n* ギアボタンメニューの中にある **拡張機能** をクリックしてください\n* **https://github.com/kawanami/contest_controller** を検索してインポートします。\n\n## このプロジェクトを編集します\n\nMakeCode でこのリポジトリを編集します。\n\n* [https://makecode.microbit.org/](https://makecode.microbit.org/) を開く\n* **読み込む** をクリックし、 **URLから読み込む...** をクリックしてください\n* **https://github.com/kawanami/contest_controller** を貼り付けてインポートをクリックしてください\n\n#### メタデータ (検索、レンダリングに使用)\n\n* for PXT/microbit\n<script src=\"https://makecode.com/gh-pages-embed.js\"></script><script>makeCodeRender(\"{{ site.makecode.home_url }}\", \"{{ site.github.owner_name }}/{{ site.github.repository_name }}\");</script>\n","main.py":"radio_group = 51\ntelloRx_server.start_receiver_pc_server(radio_group)\nbasic.show_icon(IconNames.SQUARE)","radioAck.ts":"// **未使用!!**\n// 通常のRadio通信において，ACKを追加する\n// Tello-Bridgeとの互換ないため，ボツ\n\nnamespace radioAck {\n    enum Mode {\n        None = 0,\n        Controller = 1,\n        Server = 2\n    }\n\n    let mode: Mode = Mode.None\n    let started = false\n\n    const RETRY_MAX = 3\n    const ACK_TIMEOUT_MS = 200\n\n    let seq = 0\n\n    // ACK待ち状態（送信側）\n    let waiting = false\n    let waitingSeq = 0\n    let acked = false\n\n    // Serverモード用受信ハンドラ\n    let rxHandler: (payload: string) => void = null\n\n    // ===== Logging =====\n    let DEBUG = true\n\n    function log(s: string) {\n        if (DEBUG) serial.writeLine(\"[radioAck] \" + s)\n    }\n\n    export function _setDebug(enabled: boolean) {\n        DEBUG = enabled\n        if (DEBUG) serial.writeLine(\"[radioAck] DEBUG ON\")\n    }\n\n    function initIfNeeded() {\n        if (started) return\n        started = true\n        radio.onReceivedString(onRx)\n        log(\"init ok (radio.onReceivedString registered)\")\n    }\n\n    function onRx(msg: string) {\n        log(\"RX raw: \" + msg)\n\n        const parts = msg.split(\",\")\n        if (parts.length < 2) {\n            log(\"RX ignored (too short)\")\n            return\n        }\n\n        const kind = parts[0]\n        const s = parseInt(parts[1])\n\n        // ACK受信\n        if (kind == \"A\") {\n            log(\"RX ACK seq=\" + s)\n\n            if (waiting && s == waitingSeq) {\n                acked = true\n                log(\"ACK matched! seq=\" + s)\n            } else {\n                log(\"ACK ignored (not waiting or seq mismatch)\")\n            }\n            return\n        }\n\n        // DATA受信\n        if (kind == \"D\") {\n            log(\"RX DATA seq=\" + s)\n\n            // ACK返信（必ず返す）\n            radio.sendString(`A,${s}`)\n            log(\"TX ACK seq=\" + s)\n\n            // Serverモードなら payload を上へ渡す\n            if (mode == Mode.Server && rxHandler) {\n                const payload = parts.slice(2).join(\",\")\n                log(\"PASS payload to handler: \" + payload)\n                rxHandler(payload)\n            } else {\n                log(\"payload ignored (mode=\" + mode + \")\")\n            }\n\n            return\n        }\n\n        log(\"RX ignored (unknown kind=\" + kind + \")\")\n    }\n\n    // =========================\n    // 開発者用 API（ブロックに出さない）\n    // =========================\n\n    export function _setModeController() {\n        initIfNeeded()\n        mode = Mode.Controller\n        rxHandler = null\n        log(\"mode set: Controller\")\n    }\n\n    export function _setModeServer(handler: (payload: string) => void) {\n        initIfNeeded()\n        mode = Mode.Server\n        rxHandler = handler\n        log(\"mode set: Server\")\n    }\n\n    // =========================\n    // 開発者用：ACK付き送信\n    // =========================\n\n    export function _sendWithAck(payload: string): boolean {\n        initIfNeeded()\n\n        if (waiting) {\n            log(\"SEND rejected (already waiting)\")\n            return false\n        }\n\n        seq = (seq + 1) & 0xffff\n        waiting = true\n        waitingSeq = seq\n        acked = false\n\n        log(\"SEND start seq=\" + waitingSeq + \" payload=\" + payload)\n\n        for (let i = 0; i < RETRY_MAX; i++) {\n            log(\"TX DATA try=\" + (i + 1) + \" seq=\" + waitingSeq)\n            radio.sendString(`D,${waitingSeq},${payload}`)\n\n            const t0 = control.millis()\n            while (control.millis() - t0 < ACK_TIMEOUT_MS) {\n                if (acked) {\n                    waiting = false\n                    log(\"SEND success seq=\" + waitingSeq)\n                    return true\n                }\n                basic.pause(5)\n            }\n\n            log(\"TIMEOUT waiting ACK seq=\" + waitingSeq)\n        }\n\n        waiting = false\n        log(\"SEND failed seq=\" + waitingSeq)\n        return false\n    }\n}\n","telloTx_controller.ts":"/**\n * Custom blocks\n */\n//% weight=0 color=#fc4c02 icon=\"\\u26a1\"\n//% block=\"ドローン\"\"\nnamespace Tello {\n    let flying = false\n    let camera = 0\n\n    /**\n     * 通信グループの設定を行う．受信機と送信機のグループ設定は合わせてね\n     * @param 通信グループの番号 value 0-255, eg: 1\n    */\n    //% block=\"【最初だけ】無線グループの設定を行う %value\"\n    //% group=\"設定\"\n    export function radiosetgroup(value: number): void {\n        radio.setGroup(value)\n        radio.setFrequencyBand(value % 84)\n        radio.setTransmitPower(7)\n    }\n    /**\n     * スピードの設定を行う、20~50の間で設定する、1につき1cm進む！\n     * @param スピードの設定を行う value 20-50, eg: 10\n     */\n    //% block=\"スピードを設定する(20-50:初期値は30) %value\"\n    //% group=\"設定\"\n    export function setspeed(value: number): void {\n        if (value > 50) {\n            value = 50\n        }\n        radioEzAck._sendWithAck(\"speed=\" + value)\n    }\n\n    // ----- 前後左右移動 -----\n    /**\n     * 受信機にドローンが前に進む命令を送信する．\n     * その時，距離も設定し送信を行う．20-500cm．\n     * @param value 前に進む距離を設定する（cm） value 20-500, eg: 50\n     */\n    //% block=\"前にすすむ(20-500) %value\"\n    //% group=\"基本\"\n    export function forward(value: number): void {\n        if (flying) {\n            if (value < 20) {\n                value = 20\n            }\n            radioEzAck._sendWithAck(\"forward=\" + value)\n        }\n    }\n\n    /**\n     * 受信機にドローンが後ろにすすむ命令を送信する．\n     * その時，距離も設定し送信を行う．20-500cm．\n     * @param value 後ろに進む距離を設定する（cm） value 20-500, eg: 50\n     */\n    //% block=\"後ろにすすむ(20-500) %value\"\n    //% group=\"基本\"\n    export function back(value: number): void {\n        if (flying) {\n            if (value < 20) {\n                value = 20\n            }\n            radioEzAck._sendWithAck(\"back=\" + value)\n        }\n    }\n\n    /**\n     * 受信機にドローンが左に進む命令を送信する．\n     * その時，距離も設定し送信を行う．20-500cm．\n     * @param value 左にすすむ距離を設定する（cm） value 20-500, eg: 50\n     */\n    //% block=\"左にすすむ(20-500) %value\"\n    //% group=\"基本\"\n    export function left(value: number): void {\n        if (flying) {\n            if (value < 20) {\n                value = 20\n            }\n            radioEzAck._sendWithAck(\"left=\" + value)\n        }\n    }\n\n    /**\n     * 受信機にドローンが右に進む命令を送信する．\n     * その時，距離も設定し送信を行う．20-500cm．\n     * @param value 右にすすむ距離を設定する（cm） value 20-500, eg: 50\n     */\n    //% block=\"右にすすむ(20-500) %value\"\n    //% group=\"基本\"\n    export function right(value: number): void {\n        if (flying) {\n            if (value < 20) {\n                value = 20\n            }\n            radioEzAck._sendWithAck(\"right=\" + value)\n        }\n    }\n\n    // ----- 上下移動 -----\n    /**\n     * 受信機にドローンが上に上がる命令を送信する．\n     * その時，距離も設定し送信を行う．20-500cm．\n     * @param value 上がる距離を設定する(cm) value 20-500, eg: 20\n     */\n    //% block=\"上にいく(20-500) %value\"\n    //% group=\"基本\"\n    export function up(value: number): void {\n        if (flying) {\n            if (value < 20) {\n                value = 20\n            }\n            radioEzAck._sendWithAck(\"up=\" + value)\n        }\n    }\n\n    /**\n     * 受信機にドローンが下に下る命令を送信する．\n     * その時，距離も設定し送信を行う．20-500cm．\n     * @param value 下がる距離を設定する（cm） value 20-500, eg: 20\n     */\n    //% block=\"下にいく(20-500) %value\"\n    //% group=\"基本\"\n    export function down(value: number): void {\n        if (flying) {\n            if (value < 20) {\n                value = 20\n            }\n            radioEzAck._sendWithAck(\"down=\" + value)\n        }\n    }\n\n    // ----- 回転 -----\n    /**\n     * 受信機にドローンが時計回りを行う命令を送信する．\n     * その時，角度を設定し送信を行う．\n     * @param value 時計回りを行う角度を設定する(degrees clockwise) value 1-360, eg: 90\n     */\n    //% block=\"時計まわり(1-360) %value\"\n    //% group=\"基本\"\n    export function rotate_cw(value: number): void {\n        if (flying) {\n            radioEzAck._sendWithAck(\"cw=\" + value)\n        }\n    }\n\n    /**\n     * 受信機にドローンが反時計回りを行う命令を送信する．\n     * その時，角度を設定し送信を行う．\n     * @param value 反時計回りを行う角度を設定する(degrees counterclockwise) value 1-360, eg: 90\n     */\n    //% block=\"反時計まわり(1-360) %value\"\n    //% group=\"基本\"\n    export function rotate_ccw(value: number): void {\n        if (flying) {\n            radioEzAck._sendWithAck(\"ccw=\" + value)\n        }\n    }\n\n    // ----- 離陸着陸 -----\n    /**\n      * コントローラー内の変数を確認して離陸するか，着陸を行う．\n      */\n    //% block=\"りりく/ちゃくりく\"\n    //% group=\"基本\"\n    export function fly_or_land(): void {\n        if (!flying) {\n            let takeoffOk = radioEzAck._sendWithAck(\"takeoff\")\n            if (takeoffOk) { flying = true; }\n        } else if (flying) {\n            let landOk = radioEzAck._sendWithAck(\"land\")\n            if (landOk) { flying = false; }\n        }\n    }\n\n    /**\n     * 受信機にドローンが離陸する命令を送信する．\n     */\n    //% block=\"離陸する\"\n    //% group=\"離陸と着陸\"\n    export function takeoff(): void {\n        let takeoffOk = radioEzAck._sendWithAck(\"takeoff\")\n        if (takeoffOk) { flying = true; }\n    }\n\n    /**\n     * 受信機にドローンが着陸する命令を送信する．\n    */\n    //% block=\"着陸する\"\n    //% group=\"離陸と着陸\"\n    export function land(): void {\n        let landOk = radioEzAck._sendWithAck(\"land\")\n        if (landOk) { flying = false; }\n    }\n\n    /**\n     * ドローンの飛行状態の変数を取得する．\n    */\n    //% block=\"ドローンが飛行をしている\"\n    //% group=\"離陸と着陸\"\n    export function getflying(): boolean {\n        if (flying) {\n            return true\n        } else {\n            return false\n        }\n    }\n\n    // ----- 前後左右フリップ------\n    /**\n     * ドローンが左フリップします！おしゃれ！\n     */\n    //% block=\"左フリップする(バッテリー50以上推奨)\"\n    //% group=\"フリップ\"\n    export function left_flip(): void {\n        if (flying) {\n            radioEzAck._sendWithAck(\"flip=l\")\n        }\n    }\n\n    /**\n     * ドローンが右フリップします！おしゃれ！\n     */\n    //% block=\"右フリップする(バッテリー50以上推奨)\"\n    //% group=\"フリップ\"\n    export function right_flip(): void {\n        if (flying) {\n            radioEzAck._sendWithAck(\"flip=r\")\n        }\n    }\n\n    /**\n     * ドローンが後ろフリップします！おしゃれ！\n     */\n    //% block=\"後ろフリップする(バッテリー50以上推奨)\"\n    //% group=\"フリップ\"\n    export function back_flip(): void {\n        if (flying) {\n            radioEzAck._sendWithAck(\"flip=b\")\n        }\n    }\n\n    /**\n      * ドローンが前フリップします！おしゃれ！\n      */\n    //% block=\"前フリップする(バッテリー50以上推奨)\"\n    //% group=\"フリップ\"\n    export function forward_flip(): void {\n        if (flying) {\n            radioEzAck._sendWithAck(\"flip=f\")\n        }\n    }\n\n    // -----  その他 ------\n    /**\n     * カメラを切り替える\n     */\n    //% block=\"カメラを切り替える \"\n    //% group=\"コンテスト用\"\n    export function swiching_camera(): void {\n        if (flying) {\n            if (camera) {\n                radioEzAck._sendWithAck(\"downvision 0\")\n                camera = 0\n            } else {\n                radioEzAck._sendWithAck(\"downvision 1\")\n                camera = 1\n            }\n        }\n    }\n\n    /**\n        * ドローンが三次元で移動します．20以下の移動は不可,speedは10以上．\n        * @param x x -500-500, eg: 0\n        * @param y y -500-500, eg: 0\n        * @param z z -500-500, eg: 0\n        * @param speed speed 10-100, eg: 0\n        */\n    //% block=\"自由飛行(距離は±20以上) | 前後（前が＋） %x 上下（上が＋） %y 左右（左が＋） %z スピード(10以上) %speed\"\n    //% group=\"応用\"\n    export function xyz(x: number, y: number, z: number, speed: number): void {\n        if (flying) {\n            let sendstring = \"go=\" + x + \" \" + z + \" \" + y + \" \" + speed\n            radioEzAck._sendWithAck(sendstring)\n        }\n    }\n}","telloRx_server.ts":"//% advanced=true\r\n//% block=\"⚠スタッフ用⚠ Tello受信機ブロック\"\r\n//% group.min=0 group.max=255\r\nnamespace telloRx_server {\r\n    let started = false\r\n\r\n    let hasPending = false\r\n    let pending = \"\"\r\n\r\n    // 外部クラスからシリアル送信行う用（tello_bridgeクラスで利用中）\r\n    export function _sendToSerial(s: string) {\r\n        pending = \"\" + s\r\n        hasPending = true\r\n    }\r\n\r\n    function startSerialWorkerOnce() {\r\n        control.inBackground(() => {\r\n            while (true) {\r\n                if (hasPending) {\r\n                    const s = pending\r\n                    hasPending = false\r\n\r\n                    serial.writeLine(s)\r\n                }\r\n                basic.pause(1)\r\n            }\r\n        })\r\n    }\r\n\r\n    function _startReceiverCommon(group: number, showIcon: boolean) {\r\n        if (started) return\r\n        started = true\r\n\r\n        radio.setGroup(group)\r\n        radio.setTransmitPower(7)\r\n        radio.setFrequencyBand(group % 84)\r\n\r\n        startSerialWorkerOnce()\r\n\r\n        radioEzAck._setModeServer((payload: string) => {\r\n            pending = \"\" + payload\r\n            hasPending = true\r\n        }, showIcon)\r\n    }\r\n\r\n    //% block=\"⚠スタッフ用⚠ 【最初だけ】PCサーバー受信機 （受信表示無） %group\"\r\n    //% group.min=0 group.max=255\r\n    export function startReceiverPcServerNoIcon(group: number) {\r\n        _startReceiverCommon(group, false)\r\n    }\r\n\r\n    //% block=\"⚠スタッフ用⚠ 【最初だけ】PCサーバー受信機 （受信表示有） %group\"\r\n    //% group.min=0 group.max=255\r\n    export function startReceiverPcServer(group: number) {\r\n        _startReceiverCommon(group, true)\r\n    }\r\n}","radioEzAck.ts":"// **使用中!!**\n// 通常のRadio通信において，簡易的なACK処理を追加する\n// Tello-Bridgeとの互換ありのため，採用\n\n// 問題点：Tello-Bridgeで利用する際は必ず3回コマンドが送信される．（ACK返答がないため）\n// Tello-Bridgeでは短期間における連続コマンド受信は無視するため，重複動作は行わない（動作確認済み）\n\nnamespace radioEzAck {\n    enum Mode {\n        None = 0,\n        Controller = 1,\n        Server = 2\n    }\n\n    let mode: Mode = Mode.None\n    let inited = false\n\n    const ACK_TEXT = \"OK\"\n    const RETRY_MAX = 3\n    let ACK_TIMEOUT_MS = 100\n    let SHOW_RX_CMD_ICON = false\n    let DEBUG = false\n\n    let waiting = false\n    let acked = false\n\n    let rxHandler: (cmd: string) => void = null\n\n    function log(s: string) {\n        if (DEBUG) serial.writeLine(\"[radioEzAck] \" + s)\n    }\n    export function setDebug(enabled: boolean) {\n        DEBUG = enabled\n        if (DEBUG) serial.writeLine(\"[radioEzAck] DEBUG ON\")\n    }\n    export function setAckTimeout(ms: number) {\n        ACK_TIMEOUT_MS = ms\n        log(\"ACK_TIMEOUT_MS=\" + ms)\n    }\n\n    function initIfNeeded() {\n        if (inited) return\n        inited = true\n        radio.onReceivedString(onRx)\n        log(\"init ok\")\n    }\n\n    function onRx(msg: string) {\n        // ACK受信\n        if (msg == ACK_TEXT) {\n            if (waiting) {\n                acked = true\n                log(\"RX ACK (OK) -> matched\")\n            } else {\n                log(\"RX ACK (OK) -> ignored (not waiting)\")\n            }\n            return\n        }\n\n        if (mode == Mode.Server) {\n            const cmd = \"\" + msg // 念のためコピー\n            log(\"RX CMD: \" + cmd)\n\n            // ★受信イベント内で重いことはしない：handlerもACK送信も外へ\n            control.inBackground(() => {\n                // handler（Tello-Bridge互換）\n                if (rxHandler) rxHandler(cmd)\n\n                // ACK返信（受信イベント外）\n                basic.pause(10)\n                radio.sendString(ACK_TEXT)\n                log(\"TX ACK (OK)\")\n\n                if (SHOW_RX_CMD_ICON) {\n                    basic.showIcon(IconNames.Target)\n                    basic.pause((300))\n                    basic.clearScreen()\n                }\n            })\n            return\n        }\n\n        // NOTE: サーバ → コントローラ通信実装時に利用\n        // TODO: 実装を完了させる\n        if (mode == Mode.Controller) {\n        }\n\n        log(\"RX ignored (mode=\" + mode + \" msg=\" + msg + \")\")\n    }\n\n    export function _setModeController() {\n        initIfNeeded()\n        mode = Mode.Controller\n        rxHandler = null\n        log(\"mode=Controller\")\n    }\n\n    export function _setModeServer(handler: (cmd: string) => void, showRxIcon: boolean = false) {\n        initIfNeeded()\n        mode = Mode.Server\n        rxHandler = handler\n        SHOW_RX_CMD_ICON = showRxIcon\n        log(\"mode=Server showRxIcon=\" + showRxIcon)\n    }\n\n    export function _sendWithAck(cmd: string): boolean {\n        initIfNeeded()\n\n        if (waiting) {\n            log(\"SEND rejected (already waiting)\")\n            return false\n        }\n\n        waiting = true\n        acked = false\n\n        log(\"SEND start cmd=\" + cmd)\n\n        for (let i = 0; i < RETRY_MAX; i++) {\n            log(\"TX cmd try=\" + (i + 1))\n            radio.sendString(cmd)\n\n            const t0 = control.millis()\n            while (control.millis() - t0 < ACK_TIMEOUT_MS) {\n                if (acked) {\n                    waiting = false\n                    log(\"SEND success\")\n                    return true\n                }\n                basic.pause(5)\n            }\n            log(\"TIMEOUT (no OK)\")\n        }\n\n        waiting = false\n        log(\"SEND failed\")\n        return false\n    }\n}\n","pxt.json":"{\n    \"name\": \"contest_receiver_2026\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"main.py\",\n        \"radioAck.ts\",\n        \"telloTx_controller.ts\",\n        \"telloRx_server.ts\",\n        \"radioEzAck.ts\"\n    ],\n    \"testFiles\": [\n        \"test.ts\"\n    ],\n    \"targetVersions\": {\n        \"target\": \"7.0.51\",\n        \"targetId\": \"microbit\"\n    },\n    \"supportedTargets\": [\n        \"microbit\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n","test.ts":"// テストはここに来ます。このパッケージが拡張機能として使用されるときにはコンパイルされません。\n"}}],"shares":[],"lastSaveTime":1793243828545}